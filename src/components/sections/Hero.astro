---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";
import { hero, channels } from "../../config/content";

/* Before/after diagram: scattered manual work (left) flows through the agents
   we build (centre) and comes out as ordered outcomes (right). */
const chaos = [
  { x: 100, y: 100, kind: "mail" },
  { x: 210, y: 80, kind: "doc" },
  { x: 80, y: 210, kind: "clock" },
  { x: 215, y: 235, kind: "chat" },
];
const outcomes = [
  { x: 620, y: 120, label: "Booked" },
  { x: 620, y: 200, label: "Reconciled" },
  { x: 620, y: 280, label: "Answered" },
];
---

<section id="top" class="surface-dark bg-navy-900 text-paper">
  <Container class="pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="lg:grid lg:grid-cols-2 lg:items-center lg:gap-10">

      <!-- Left column: copy -->
      <div class="text-center lg:text-left">
        <p
          class="reveal in flex items-center justify-center gap-2.5 text-label font-semibold uppercase text-teal-400 lg:justify-start"
        >
          <span class="live-dot inline-block size-2 rounded-full bg-teal-400"></span>
          {hero.status}
          <span class="mx-1 text-slate-300/40" aria-hidden="true">/</span>
          <span class="text-slate-300">{hero.eyebrow}</span>
        </p>

        <h1
          class="reveal in mt-7 font-display text-display font-semibold"
        >
          {hero.headline[0]} <span class="text-gold">{hero.headline[1]}</span>
        </h1>

        <p class="reveal in mx-auto mt-7 max-w-xl text-lead text-slate-300 lg:mx-0">
          {hero.lead}
        </p>

        <div class="reveal in mt-10 flex flex-wrap justify-center gap-3 lg:justify-start">
          <Button href="#contact" size="lg" track="cta_map_workflow">{hero.primaryCta}</Button>
          <Button href="#operations" variant="ghost-dark" size="lg" track="cta_see_operations">
            {hero.secondaryCta}
          </Button>
        </div>

        <p class="mt-6 text-label font-medium uppercase text-slate-300">
          {hero.footnote}
        </p>

        <!-- Below md the diagram's labels shrink past legibility, so the same
             channels are listed as chips instead. -->
        <ul class="reveal mt-14 flex flex-wrap justify-center gap-2 lg:hidden">
          {
            channels.map((c) => (
              <li class="flex items-center gap-2 rounded-full border border-hairline-dark px-3.5 py-2 text-label font-semibold uppercase text-slate-300">
                <span class="size-1.5 rounded-full bg-teal-400" aria-hidden="true" />
                {c}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right column: before/after diagram, lg+ only -->
      <!-- Manual chaos in, ordered outcomes out. Decorative: the story is told
           in copy elsewhere, so the diagram is hidden from assistive tech. -->
      <div class="reveal hidden lg:flex lg:items-center lg:justify-center" aria-hidden="true">
        <svg
          viewBox="0 0 720 400"
          class="w-full"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
        <text x="40" y="32" fill="var(--color-slate-300)" font-family="var(--font-sans)" font-size="13" font-weight="600" letter-spacing="1.4">MANUAL</text>
        <text x="680" y="32" text-anchor="end" fill="var(--color-gold)" font-family="var(--font-sans)" font-size="13" font-weight="600" letter-spacing="1.4">AUTOMATED</text>
        <line x1="300" y1="48" x2="300" y2="352" stroke="var(--color-slate-300)" stroke-width="2" stroke-dasharray="4 8" opacity="0.3" />

        <!-- Scattered manual work: muted glyphs, tangled static connectors -->
        <g stroke="var(--color-slate-300)" stroke-width="2" opacity="0.55">
          <rect x="86" y="90" width="28" height="20" rx="3" />
          <path d="M86 90 l14 10 14-10" />
          <rect x="200" y="66" width="20" height="28" rx="2" />
          <line x1="204" y1="76" x2="216" y2="76" />
          <line x1="204" y1="84" x2="216" y2="84" />
          <circle cx="80" cy="210" r="12" />
          <path d="M80 210 v-7 M80 210 l5 4" />
          <rect x="201" y="224" width="28" height="20" rx="6" />
          <path d="M208 244 l-2 8 10-8" />
        </g>
        <g stroke="var(--color-slate-300)" stroke-width="2" stroke-dasharray="5 6" opacity="0.3" fill="none">
          <path d="M114 106 C150 118, 160 100, 198 88" />
          <path d="M92 218 C130 226, 160 210, 201 230" />
          <path d="M108 112 C140 160, 150 180, 203 228" />
        </g>

        <!-- Clean conduit: chaos flows into the agents we built -->
        <g stroke="var(--color-teal)" stroke-width="3">
          <path class="trace" style="--trace-len:130" d="M252 120 H300 L348 182" />
          <path class="trace" style="--trace-len:100" d="M252 200 H348" />
          <path class="trace" style="--trace-len:130" d="M252 280 H300 L348 218" />
          <path class="trace" style="--trace-len:210" d="M432 182 H540 L618 122" stroke="var(--color-gold)" />
          <path class="trace" style="--trace-len:190" d="M432 200 H618" stroke="var(--color-gold)" />
          <path class="trace" style="--trace-len:210" d="M432 218 H540 L618 278" stroke="var(--color-gold)" />
        </g>

        <g fill="var(--color-teal)">
          {outcomes.map((n) => <circle cx={n.x} cy={n.y} r="5" />)}
        </g>

        <!-- Agent activity ring: pulses outward to show active processing -->
        <circle class="agent-ring" cx="390" cy="200" r="48" fill="none" stroke="var(--color-teal)" stroke-width="1.5" />

        <!-- Agent node: the mark's gold chevron over a navy body. -->
        <rect
          x="350"
          y="160"
          width="80"
          height="80"
          rx="22"
          fill="var(--color-navy-700)"
          stroke="var(--color-teal)"
          stroke-width="2"
        />
        <path
          d="M377 181 L401 200 L377 219"
          stroke="var(--color-gold)"
          stroke-width="9"
        />
        <rect x="408" y="179" width="7" height="42" rx="3.5" fill="var(--color-paper)" />
        <text x="390" y="272" text-anchor="middle" fill="var(--color-teal-400)" font-family="var(--font-sans)" font-size="12" font-weight="600" letter-spacing="1.4">YOUR AGENTS</text>

        <g
          fill="var(--color-slate-300)"
          font-family="var(--font-sans)"
          font-size="13"
          font-weight="600"
          letter-spacing="1.4"
        >
          {outcomes.map((n) => (
            <text x={n.x + 16} y={n.y + 4}>
              {n.label.toUpperCase()}
            </text>
          ))}
        </g>

        <!-- Data-flow dots: teal = chaos entering, gold = outcomes leaving -->
        <circle class="flow-dot" r="3" fill="var(--color-teal-400)" style="offset-path: path('M252 120 H300 L348 182'); animation-delay: 0s;" />
        <circle class="flow-dot" r="3" fill="var(--color-teal-400)" style="offset-path: path('M252 200 H348'); animation-delay: 0.8s;" />
        <circle class="flow-dot" r="3" fill="var(--color-teal-400)" style="offset-path: path('M252 280 H300 L348 218'); animation-delay: 1.6s;" />
        <circle class="flow-dot" r="3" fill="var(--color-gold)" style="offset-path: path('M432 182 H540 L618 122'); animation-delay: 0.4s;" />
        <circle class="flow-dot" r="3" fill="var(--color-gold)" style="offset-path: path('M432 200 H618'); animation-delay: 1.2s;" />
        <circle class="flow-dot" r="3" fill="var(--color-gold)" style="offset-path: path('M432 218 H540 L618 278'); animation-delay: 2s;" />

        <!-- Growth sparkline: draws once after traces, signals faster business -->
        <polyline
          class="sparkline"
          style="--spark-len:190"
          points="470,362 530,354 590,342 650,328"
          fill="none"
          stroke="var(--color-gold)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <g class="spark-label">
          <circle cx="650" cy="328" r="3.5" fill="var(--color-gold)" />
          <path d="M642 335 L650 328 L658 335" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <text x="665" y="332" fill="var(--color-gold)" font-family="var(--font-sans)" font-size="11" font-weight="700" letter-spacing="0.5">10×</text>
        </g>

      </svg>
      </div>

    </div>
  </Container>
</section>
