---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";
import { hero, channels } from "../../config/content";

/* Endpoint rows for the circuit diagram, mirroring the logomark's traces. */
const left = [
  { y: 60,  label: "Calls" },
  { y: 150, label: "Chats" },
  { y: 250, label: "Invoices" },
  { y: 340, label: "WhatsApp" },
];
const right = [
  { y: 60,  label: "Leads" },
  { y: 150, label: "Inbox" },
  { y: 250, label: "Reports" },
  { y: 340, label: "CRM" },
];
---

<section id="top" class="surface-dark bg-navy-900 text-paper">
  <Container class="pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="lg:grid lg:grid-cols-2 lg:items-center lg:gap-10">

      <!-- Left column: copy -->
      <div class="text-center lg:text-left">
        <p
          class="reveal in flex items-center justify-center gap-2.5 text-label font-semibold uppercase text-teal-400 lg:justify-start"
        >
          <span class="live-dot inline-block size-2 rounded-full bg-teal-400"></span>
          {hero.status}
          <span class="mx-1 text-slate-300/40" aria-hidden="true">/</span>
          <span class="text-slate-300">{hero.eyebrow}</span>
        </p>

        <h1
          class="reveal in mt-7 font-display text-display font-semibold"
        >
          {hero.headline[0]} <span class="text-gold">{hero.headline[1]}</span>
        </h1>

        <p class="reveal in mx-auto mt-7 max-w-xl text-lead text-slate-300 lg:mx-0">
          {hero.lead}
        </p>

        <div class="reveal in mt-10 flex flex-wrap justify-center gap-3 lg:justify-start">
          <Button href="#contact" size="lg">{hero.primaryCta}</Button>
          <Button href="#operations" variant="ghost-dark" size="lg">
            {hero.secondaryCta}
          </Button>
        </div>

        <p class="mt-6 text-label font-medium uppercase text-slate-300">
          {hero.footnote}
        </p>

        <!-- Below md the diagram's labels shrink past legibility, so the same
             channels are listed as chips instead. -->
        <ul class="reveal mt-14 flex flex-wrap justify-center gap-2 lg:hidden">
          {
            channels.map((c) => (
              <li class="flex items-center gap-2 rounded-full border border-hairline-dark px-3.5 py-2 text-label font-semibold uppercase text-slate-300">
                <span class="size-1.5 rounded-full bg-teal-400" aria-hidden="true" />
                {c}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right column: circuit diagram, md+ only -->
      <!-- One agent, many channels. Decorative: the labels are duplicated
           in the Operations table, so the diagram is hidden from assistive tech. -->
      <div class="reveal hidden lg:flex lg:items-center lg:justify-center" aria-hidden="true">
        <svg
          viewBox="0 0 720 400"
          class="w-full"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
        <g stroke="var(--color-teal)" stroke-width="3">
          <path class="trace" style="--trace-len:270" d="M310 200 H240 L150 60 H128" />
          <path class="trace" style="--trace-len:205" d="M310 200 H255 L150 150 H128" />
          <path class="trace" style="--trace-len:205" d="M310 200 H255 L150 250 H128" />
          <path class="trace" style="--trace-len:270" d="M310 200 H240 L150 340 H128" />
          <path class="trace" style="--trace-len:270" d="M410 200 H480 L570 60 H592" />
          <path class="trace" style="--trace-len:205" d="M410 200 H465 L570 150 H592" />
          <path class="trace" style="--trace-len:205" d="M410 200 H465 L570 250 H592" />
          <path class="trace" style="--trace-len:270" d="M410 200 H480 L570 340 H592" />
        </g>

        <g fill="var(--color-teal)">
          {left.map((n) => <circle cx="120" cy={n.y} r="5" />)}
          {right.map((n) => <circle cx="600" cy={n.y} r="5" />)}
        </g>

        <!-- Agent activity ring: pulses outward to show active processing -->
        <circle class="agent-ring" cx="360" cy="200" r="48" fill="none" stroke="var(--color-teal)" stroke-width="1.5" />

        <!-- Agent node: the mark's gold chevron over a navy body. -->
        <rect
          x="320"
          y="160"
          width="80"
          height="80"
          rx="22"
          fill="var(--color-navy-700)"
          stroke="var(--color-teal)"
          stroke-width="2"
        />
        <path
          d="M347 181 L371 200 L347 219"
          stroke="var(--color-gold)"
          stroke-width="9"
        />
        <rect x="378" y="179" width="7" height="42" rx="3.5" fill="var(--color-paper)" />

        <g
          fill="var(--color-slate-300)"
          font-family="var(--font-sans)"
          font-size="13"
          font-weight="600"
          letter-spacing="1.4"
        >
          {left.map((n) => (
            <text x="104" y={n.y + 4} text-anchor="end">
              {n.label.toUpperCase()}
            </text>
          ))}
          {right.map((n) => (
            <text x="616" y={n.y + 4}>
              {n.label.toUpperCase()}
            </text>
          ))}
        </g>

        <!-- Data-flow dots: teal = inputs entering the agent, gold = outputs leaving -->
        <circle class="flow-dot" r="3" fill="var(--color-teal-400)" style="offset-path: path('M128 60 H150 L240 200 H310'); animation-delay: 0s;" />
        <circle class="flow-dot" r="3" fill="var(--color-teal-400)" style="offset-path: path('M128 150 H150 L255 200 H310'); animation-delay: 0.7s;" />
        <circle class="flow-dot" r="3" fill="var(--color-teal-400)" style="offset-path: path('M128 250 H150 L255 200 H310'); animation-delay: 1.4s;" />
        <circle class="flow-dot" r="3" fill="var(--color-teal-400)" style="offset-path: path('M128 340 H150 L240 200 H310'); animation-delay: 2.1s;" />
        <circle class="flow-dot" r="3" fill="var(--color-gold)" style="offset-path: path('M410 200 H480 L570 60 H592'); animation-delay: 0.35s;" />
        <circle class="flow-dot" r="3" fill="var(--color-gold)" style="offset-path: path('M410 200 H465 L570 150 H592'); animation-delay: 1.05s;" />
        <circle class="flow-dot" r="3" fill="var(--color-gold)" style="offset-path: path('M410 200 H465 L570 250 H592'); animation-delay: 1.75s;" />
        <circle class="flow-dot" r="3" fill="var(--color-gold)" style="offset-path: path('M410 200 H480 L570 340 H592'); animation-delay: 2.45s;" />

        <!-- Growth sparkline: draws once after traces, signals upward business output -->
        <polyline
          class="sparkline"
          style="--spark-len:228"
          points="250,392 310,384 370,374 430,366 470,360"
          fill="none"
          stroke="var(--color-gold)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <g class="spark-label">
          <circle cx="470" cy="360" r="3.5" fill="var(--color-gold)" />
          <path d="M462 367 L470 360 L478 367" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <text x="485" y="364" fill="var(--color-gold)" font-family="var(--font-sans)" font-size="11" font-weight="700" letter-spacing="0.5">10×</text>
        </g>

      </svg>
      </div>

    </div>
  </Container>
</section>
