    "M14 2v6h6",
    "M16 13H8",
    "M16 17H8",
    "M10 9H8",
  ],
  message: [
    "M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z",
  ],
  headphones: [
    "M3 18v-6a9 9 0 0118 0v6",
    "M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3z",
    "M3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z",
  ],
  refresh: [
    "M23 4v6h-6",
    "M1 20v-6h6",
    "M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15",
  ],
  "bar-chart": [
    "M18 20V10",
    "M12 20V4",
    "M6 20v-6",
  ],
  "credit-card": [
    "M21 4H3a2 2 0 00-2 2v12a2 2 0 002 2h18a2 2 0 002-2V6a2 2 0 00-2-2z",
    "M1 10h22",
  ],
  mic: [
    "M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z",
    "M19 10v2a7 7 0 01-14 0v-2",
    "M12 19v4",
    "M8 23h8",
  ],
  database: [
    "M12 2c-4.97 0-9 1.34-9 3s4.03 3 9 3 9-1.34 9-3-4.03-3-9-3z",
    "M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5",
    "M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3",
  ],
  "trending-up": [
    "M23 6l-9.5 9.5-5-5L1 18",
    "M17 6h6v6",
  ],
  search: [
    "M11 19a8 8 0 100-16 8 8 0 000 16z",
