---

<Section id="operations" surface="paper">
  <div class="max-w-2xl">
    <Eyebrow n="01">Operations we take over</Eyebrow>
    <h2 class="mt-5 font-display text-h2 font-semibold">
      The busywork your team hates? Hand it over.
    </h2>
  </div>

  <div class="reveal mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      operations.map((o) => (
        <div class="flex flex-col rounded-lg border border-hairline bg-paper-dim p-6">
          <div
            class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-teal"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="white"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {ICONS[o.icon]?.map((d) => <path d={d} />)}
            </svg>
          </div>

          <p class="mt-4 text-label font-semibold uppercase text-slate-600">
            {o.pain}
          </p>
          <p class="mt-2 flex-1 font-medium text-navy-800">{o.outcome}</p>

          <p class="mt-5 text-label font-semibold uppercase text-teal-600">
            {o.stat}
          </p>
        </div>
      ))
    }

    <!-- Additional features card — dark band to stand out -->
    <div class="flex flex-col rounded-lg bg-navy-800 p-6">
      <div
        class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-navy-700"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="var(--color-teal-400)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 5v14M5 12h14" />
        </svg>
      </div>

      <p class="mt-4 font-display text-h3 font-semibold text-paper">
        Something else slowing you down?
      </p>
      <p class="mt-2 flex-1 text-slate-300">
        If it burns hours or needs ten clicks — we automate it or build a custom
        tool that your team owns.
      </p>

      <a
        href="#contact"
        class="mt-5 inline-flex items-center gap-1.5 text-label font-semibold uppercase text-teal-400"
      >
        Tell us your workflow
        <svg
          viewBox="0 0 24 24"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</Section>
