---
import Section from "../layout/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Card from "../ui/Card.astro";
import { steps } from "../../config/content";
---

<Section id="how" surface="paper-dim">
  <div class="max-w-2xl">
    <Eyebrow n="02">How it works</Eyebrow>
    <h2 class="mt-5 font-display text-h2 font-semibold">
      Story, blueprint, then a machine that runs itself.
    </h2>
  </div>

  <div class="mt-14 grid gap-5 md:grid-cols-3">
    {
      steps.map((s) => (
        <Card class="reveal">
          <p class="font-display text-label font-bold uppercase text-teal-600">
            {s.n}
          </p>
          <h3 class="mt-4 font-display text-h3 font-semibold">{s.title}</h3>
          <p class="mt-3 text-sm text-slate">{s.text}</p>
        </Card>
      ))
    }
  </div>
</Section>
