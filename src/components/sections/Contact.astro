---
import Section from "../layout/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Field from "../ui/Field.astro";
import Button from "../ui/Button.astro";
import { site } from "../../config/site";
import { asset } from "../../lib/url";
import { contact } from "../../config/content";
---

<Section id="contact" surface="navy-deep" class="border-none">
  <div class="grid gap-14 md:grid-cols-2 md:gap-20">
    <div class="reveal">
      <Eyebrow n="06" surface="dark">{contact.eyebrow}</Eyebrow>
      <h2 class="mt-5 font-display text-h2 font-semibold">{contact.heading}</h2>
      <p class="mt-5 max-w-md text-slate-300">{contact.body}</p>

      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={site.whatsapp} variant="primary" external track="contact_whatsapp">
          {contact.whatsappCta}
        </Button>
        <Button href={`mailto:${site.email}`} variant="ghost-dark" track="contact_mailto">
          {site.email}
        </Button>
      </div>
      <p class="mt-5 text-sm text-slate-300">
        {contact.whatsappImmediate}{" "}
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-paper underline decoration-teal-400 underline-offset-4 transition-colors hover:text-teal-400"
        >
          {site.whatsappDisplay}
        </a>
      </p>
      <p class="mt-5 text-sm text-slate-300">
        Prefer email? For enquiries, write to{" "}
        <a
          href={`mailto:${site.email}`}
          class="font-semibold text-paper underline decoration-teal-400 underline-offset-4 transition-colors hover:text-teal-400"
        >
          {site.email}
        </a>
      </p>
    </div>

    <form
      class="reveal rounded-lg border border-hairline-dark bg-paper p-6 md:p-8"
      data-contact-form
    >
      <div class="space-y-5 md:space-y-6">
        <Field
          name="name"
          label="Your name"
          placeholder="Jane Patel"
          autocomplete="name"
          required
          minlength={2}
          maxlength={80}
        />
        <Field
          name="business"
          label="Business (optional)"
          placeholder="Patel Realty"
          autocomplete="organization"
          maxlength={120}
        />
        <div>
          <span class="text-label font-semibold uppercase text-slate">
            Phone<span class="text-teal-600" aria-hidden="true"> *</span>
          </span>
          <div class="mt-2 flex gap-2">
            <input
              type="text"
              name="country_code"
              value="+91"
              required
              aria-label="Country code"
              autocomplete="tel-country-code"
              class="w-20 shrink-0 rounded-md border border-hairline bg-paper px-3 py-2.5 text-center text-body text-navy-800 outline-none transition-colors focus:border-teal md:py-3 md:text-lead"
            />
            <input
              type="tel"
              name="phone"
              required
              placeholder="98765 43210"
              inputmode="numeric"
              autocomplete="tel-national"
              aria-label="Phone number"
              class="w-full rounded-md border border-hairline bg-paper px-3 py-2.5 text-body text-navy-800 outline-none transition-colors placeholder:text-slate focus:border-teal md:px-4 md:py-3 md:text-lead"
            />
          </div>
          <p class="mt-1 text-sm text-slate-600" data-phone-hint>
            10-digit mobile number, no OTP needed.
          </p>
        </div>
        <Field
          name="email"
          type="email"
          label="Email (optional)"
          placeholder="you@company.com"
          autocomplete="email"
          maxlength={254}
        />
        <Field
          name="message"
          type="textarea"
          label="What's eating your week?"
          placeholder="e.g. We miss weekend enquiries and invoicing takes every Friday…"
          required
          minlength={10}
          maxlength={2000}
        />
        <!-- Honeypot: humans never see/fill this; bots do. -->
        <input
          type="text"
          name="company_website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />
      </div>

      <button
        type="submit"
        class="mt-6 w-full rounded-full bg-gold px-6 py-3 font-semibold text-navy-900 transition-colors hover:bg-gold-600 disabled:opacity-60 md:mt-7 md:py-3.5"
        data-submit
      >
        Send — get your workflow map
      </button>

      <p
        class="mt-3 hidden text-center text-sm text-teal-600"
        data-form-note
        role="status"
      >
      </p>
    </form>
  </div>

  <!-- Success modal: shown after the lead is stored. -->
  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-navy-900/70 p-6"
    data-success-modal
  >
    <div
      class="w-full max-w-sm rounded-lg border border-hairline bg-paper p-8 text-center text-navy-800"
      role="dialog"
      aria-modal="true"
      aria-labelledby="success-title"
    >
      <img
        src={asset("success.gif")}
        alt="Success — your request was received"
        width="160"
        height="160"
        class="mx-auto size-24"
      />
      <h3 id="success-title" class="mt-5 font-display text-h3 font-semibold">
        Request received!
      </h3>
      <p class="mt-2 font-display text-h3 font-semibold text-teal-600">
        Your business is about to run itself.
      </p>
      <p class="mt-3 text-sm text-slate-600">
        Our team will get back within a few hours with your workflow map.
      </p>
      <button
        type="button"
        class="mt-6 w-full rounded-full bg-gold px-6 py-3 font-semibold text-navy-900 transition-colors hover:bg-gold-600"
        data-modal-close
      >
        Done
      </button>
    </div>
  </div>
</Section>

<script define:vars={{ email: site.email, api: site.leadsApi, whatsapp: site.whatsapp }}>
  // Submit to the leads API; fall back to mailto/WhatsApp if the network fails.
  const form = document.querySelector("[data-contact-form]");
  const note = document.querySelector("[data-form-note]");
  const submitBtn = document.querySelector("[data-submit]");
  const modal = document.querySelector("[data-success-modal]");
  const modalClose = document.querySelector("[data-modal-close]");

  const openModal = () => {
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    document.body.style.overflow = "hidden";
    modalClose?.focus();
  };
  const closeModal = () => {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    document.body.style.overflow = "";
    submitBtn?.focus();
  };
  modalClose?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) closeModal();
  });

  const track = (name) => {
    if (typeof window.trackEvent === "function") window.trackEvent(name);
  };
  form?.addEventListener("input", () => track("form_start"), { once: true });

  const showNote = (text, ok) => {
    if (!note) return;
    note.textContent = text;
    note.classList.remove("hidden");
    note.classList.toggle("text-teal-600", ok !== false);
  };

  // Live phone guard: +91 (or blank cc) caps the number at 10 digits and
  // strips non-digits as you type; other country codes type freely.
  const ccInput = form?.querySelector('[name="country_code"]');
  const phoneInput = form?.querySelector('[name="phone"]');
  const isIndiaCc = () => {
    const ccD = (ccInput?.value || "").replace(/\D/g, "");
    return ccD === "" || ccD === "91";
  };
  const enforcePhone = () => {
    if (!phoneInput) return;
    if (isIndiaCc()) {
      phoneInput.maxLength = 10;
      phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 10);
    } else {
      phoneInput.removeAttribute("maxlength");
    }
  };
  ccInput?.addEventListener("input", enforcePhone);
  phoneInput?.addEventListener("input", enforcePhone);
  enforcePhone();

  const mailtoHref = (data) => {
    const get = (key) => String(data.get(key) ?? "").trim();
    const subject = `Workflow map request — ${get("business") || get("name")}`;
    const body = [
      `Name: ${get("name")}`,
      `Business: ${get("business") || "—"}`,
      `Phone: ${get("country_code")} ${get("phone")}`,
      "",
      get("message"),
    ].join("\n");
    return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const target = event.target;
    if (!target.reportValidity()) return;
    const data = new FormData(target);
    const get = (key) => String(data.get(key) ?? "").trim();

    // Phone is required: India (+91) needs exactly 10 digits,
    // other country codes skip the length check (no OTP flow).
    // Email is optional: validated only when filled.
    const ccDigits = get("country_code").replace(/\D/g, "");
    const phoneDigits = get("phone").replace(/\D/g, "");
    let phoneFull = "";
    if (ccDigits === "" || ccDigits === "91") {
      if (phoneDigits.length !== 10) {
        showNote("Please enter a valid 10-digit mobile number.", false);
        return;
      }
      phoneFull = `+91 ${phoneDigits}`;
    } else {
      if (phoneDigits.length < 4) {
        showNote("Please enter a valid phone number.", false);
        return;
      }
      phoneFull = `+${ccDigits} ${phoneDigits}`;
    }
    const emailVal = get("email");
    if (emailVal !== "" && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(emailVal)) {
      showNote("Please enter a valid email address.", false);
      return;
    }

    submitBtn?.setAttribute("disabled", "");
    showNote("Sending…");

    try {
      // Same-origin first: no CORS preflight, works inside Instagram/FB
      // webviews. Direct backend second (local dev has no site worker).
      const payload = JSON.stringify({
        name: get("name"),
        business: get("business"),
        email: emailVal,
        phone: phoneFull,
        message: get("message"),
        company_website: get("company_website"),
        source: "kelvarix.in",
      });
      const postLead = (url) =>
        fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: payload,
        });
      let res;
      try {
        res = await postLead("/api/leads");
        if (res.status === 404) res = await postLead(`${api}/api/leads`);
      } catch {
        res = await postLead(`${api}/api/leads`);
      }
      if (!res.ok) {
        if (res.status === 422) {
          const detail = await res.json().catch(() => ({}));
          const fields = detail.fields || [];
          showNote(
            fields.includes("message")
              ? "Please tell us a little more — a sentence or two about what's eating your week."
                : fields.includes("phone")
                  ? "Please enter a valid 10-digit mobile number."
                  : fields.includes("email")
                    ? "Please enter a valid email address."
                    : `Please check the highlighted fields (${fields.join(", ") || "form"}) and try again.`,
            false,
          );
          return;
        }
        throw new Error(`leads-api-${res.status}`);
      }
      target.reset();
      note?.classList.add("hidden");
      track("form_submit_success");
      openModal();
    } catch {
      // Offline/API down: hand off to the visitor's mail client or WhatsApp.
      track("form_submit_fallback");
      note?.classList.remove("hidden");
      const waBase = String(whatsapp).split("?")[0];
      const wa = `${waBase}?text=${encodeURIComponent(
        `Hi Kelvarix, I'm ${get("name")} (${get("country_code")} ${get("phone")}). ${get("message")}`,
      )}`;
      note.innerHTML = `Couldn't send directly — <a href="${mailtoHref(data)}" class="font-semibold underline">open your email app</a> or <a href="${wa}" target="_blank" rel="noopener" class="font-semibold underline">continue on WhatsApp</a>.`;
    } finally {
      submitBtn?.removeAttribute("disabled");
    }
  });
</script>
