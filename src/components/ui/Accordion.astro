---
/** Native <details> disclosure — keyboard accessible with no JS. */
interface Props {
  q: string;
  a: string;
}

const { q, a } = Astro.props;
---

<details class="reveal group border-b border-hairline py-5">
  <summary
    class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-h3 font-semibold"
  >
    <span>{q}</span>
    <span
      class="mt-1 grid size-6 shrink-0 place-items-center rounded-full border border-hairline text-teal-600 transition-transform duration-200 group-open:rotate-45"
      aria-hidden="true">+</span
    >
  </summary>
  <p class="mt-3 max-w-prose text-slate-600">{a}</p>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
