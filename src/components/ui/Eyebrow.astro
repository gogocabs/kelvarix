---
/** Numbered section label. Teal is the signal colour, darkened for AA on light. */
interface Props {
  n?: string;
  surface?: "light" | "dark";
  class?: string;
}

const { n, surface = "light", class: className = "" } = Astro.props;
---

<p
  class:list={[
    "flex items-center gap-3 text-label font-semibold uppercase",
    surface === "dark" ? "text-teal-400" : "text-teal-600",
    className,
  ]}
>
  {
    n && (
      <span
        class:list={[
          "tabular-nums",
          surface === "dark" ? "text-slate-300" : "text-slate-600",
        ]}
      >
        {n}
      </span>
    )
  }
  <span class:list={["h-px w-6", surface === "dark" ? "bg-teal-400/50" : "bg-teal-600/40"]}></span>
  <slot />
</p>
