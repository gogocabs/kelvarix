---
/**
 * Variants are surface-aware because gold only reaches 2.2:1 against paper —
 * it is always a *filled* button with navy text, never gold text on light.
 */
interface Props {
  href: string;
  variant?: "primary" | "ghost" | "ghost-dark";
  size?: "md" | "lg";
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  class: className = "",
} = Astro.props;

const variants = {
  /* Gold fill + navy label = 5.5:1. */
  primary: "bg-gold text-navy-900 hover:bg-gold-600",
  /* On light surfaces. */
  ghost: "border border-navy-800/25 text-navy-800 hover:border-navy-800 hover:bg-paper-dim",
  /* On dark surfaces. */
  "ghost-dark": "border border-slate-300/30 text-paper hover:border-teal-400 hover:text-teal-400",
} as const;

const sizes = {
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-4 text-base",
} as const;
---

<a
  href={href}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  class:list={[
    "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full font-semibold transition-colors duration-200",
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</a>
