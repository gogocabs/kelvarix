---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="reveal border-t border-hairline-dark pt-5">
  <p class="font-display text-h2 font-semibold tracking-tight text-gold">
    {value}
  </p>
  <p class="mt-2 text-sm text-slate-300">{label}</p>
</div>
