---
import { site, navLinks } from "../config/site";
---
<header class="sticky top-0 z-40 border-b border-hairline bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-6 px-5 py-4">
    <a href="#top" class="font-display text-xl font-bold tracking-tight">Kelvarix<span class="text-accent">.</span></a>
    <nav class="ml-auto hidden items-center gap-6 md:flex" aria-label="Primary">
      {navLinks.map((l) => <a href={l.href} class="text-sm text-muted hover:text-ink">{l.label}</a>)}
    </nav>
    <a href="#contact" class="ml-auto md:ml-0 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper hover:bg-accent transition-colors">Book a consult</a>
  </div>
</header>
