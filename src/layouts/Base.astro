---
import "../styles/global.css";
import { site } from "../config/site";
import { asset } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.tagline} | Convert your business to AI with ${site.name}`,
  description = site.description,
} = Astro.props;

/* Astro.site is set in astro.config.mjs; fall back to the current request
   origin so `astro dev` still emits valid absolute URLs. */
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(asset("og.png"), origin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${origin}#org`,
      name: site.name,
      slogan: site.tagline,
      description: site.description,
      url: origin instanceof URL ? origin.href : String(origin),
      logo: new URL(asset("favicon-512.png"), origin).href,
      image: ogImage,
      email: site.email,
      keywords: site.keywords.join(", "),
    },
    {
      "@type": "WebSite",
      "@id": `${origin}#website`,
      url: origin instanceof URL ? origin.href : String(origin),
      name: `${site.name} — ${site.tagline}`,
      description: site.description,
      publisher: { "@id": `${origin}#org` },
      inLanguage: "en",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(", ")} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="googlebot" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#173B57" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href={asset("favicon.ico")} sizes="32x32" />
    <link rel="icon" type="image/png" href={asset("favicon-192.png")} sizes="192x192" />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    <link rel="manifest" href={asset("site.webmanifest")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — Convert your business to AI with ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — Convert your business to AI with ${site.name}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-navy-800 focus:px-5 focus:py-2.5 focus:text-paper"
    >
      Skip to content
    </a>

    <slot />

    <script>
      // Reveal-on-scroll. Elements already marked `in` (above the fold) are
      // untouched; if IntersectionObserver is missing, everything is shown.
      const targets = [...document.querySelectorAll(".reveal:not(.in)")];

      if (!("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("in"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("in");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.15 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
